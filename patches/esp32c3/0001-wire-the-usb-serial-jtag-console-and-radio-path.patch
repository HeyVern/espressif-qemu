diff --git a/hw/riscv/esp32c3.c b/hw/riscv/esp32c3.c
index ed698fb..bcde644 100644
--- a/hw/riscv/esp32c3.c
+++ b/hw/riscv/esp32c3.c
@@ -47,6 +47,8 @@
 #include "hw/misc/esp32c3_ds.h"
 #include "hw/misc/esp32c3_xts_aes.h"
 #include "hw/misc/esp32c3_jtag.h"
+#include "hw/xtensa/bramble_gpio.h"
+#include "hw/xtensa/bramble_gpspi2.h"
 #include "hw/dma/esp32c3_gdma.h"
 #include "hw/display/esp_rgb.h"
 #include "hw/net/can/esp32c3_twai.h"
@@ -448,9 +450,20 @@ static void esp32c3_machine_init(MachineState *machine)
     /* Initialize OpenCores Ethernet controller now sicne it requires the interrupt matrix */
     esp32c3_init_openeth(ms);
 
-    /* USB Serial JTAG realization */
+    /* Radio path: the GPIO out-observer the CS framing needs, then the GPSPI2
+     * controller with its SX1262 slave. Board wiring comes from -global. */
+    bramble_gpio_attach(sys_mem, NULL);
+    bramble_gpspi2_attach(sys_mem, NULL, NULL);
+
+    /* USB Serial JTAG realization. The two UARTs take serial 0 and 1, so the SoC's
+     * own USB console lands on serial 2 -- which is where a hardware-CDC build puts
+     * stdout and reads its commands from. */
     {
+        qdev_prop_set_chr(DEVICE(&ms->jtag), "chardev", serial_hd(ESP32C3_UART_COUNT));
         sysbus_realize(SYS_BUS_DEVICE(&ms->jtag), &error_fatal);
+        sysbus_connect_irq(SYS_BUS_DEVICE(&ms->jtag), 0,
+                           qdev_get_gpio_in(intmatrix_dev,
+                                            ETS_USB_SERIAL_JTAG_INTR_SOURCE));
         MemoryRegion *mr = sysbus_mmio_get_region(SYS_BUS_DEVICE(&ms->jtag), 0);
         memory_region_add_subregion_overlap(sys_mem, DR_REG_USB_SERIAL_JTAG_BASE, mr, 0);
     }
