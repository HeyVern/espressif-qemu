diff --git a/hw/riscv/esp32c3.c b/hw/riscv/esp32c3.c
index ed698fb..09458c3 100644
--- a/hw/riscv/esp32c3.c
+++ b/hw/riscv/esp32c3.c
@@ -47,6 +47,9 @@
 #include "hw/misc/esp32c3_ds.h"
 #include "hw/misc/esp32c3_xts_aes.h"
 #include "hw/misc/esp32c3_jtag.h"
+#include "hw/i2c/esp32_i2c.h"
+#include "hw/xtensa/bramble_gpio.h"
+#include "hw/xtensa/bramble_gpspi2.h"
 #include "hw/dma/esp32c3_gdma.h"
 #include "hw/display/esp_rgb.h"
 #include "hw/net/can/esp32c3_twai.h"
@@ -88,6 +91,7 @@ struct Esp32C3MachineState {
     ESP32C3SpiState spi1;
     ESP32C3RtcCntlState rtccntl;
     ESP32C3UsbJtagState jtag;
+    Esp32I2CState i2c;
     ESPRgbState rgb;
     Esp32C3TWAIState twai;
 };
@@ -422,6 +426,7 @@ static void esp32c3_machine_init(MachineState *machine)
     object_initialize_child(OBJECT(machine), "spi1", &ms->spi1, TYPE_ESP32C3_SPI);
     object_initialize_child(OBJECT(machine), "rtccntl", &ms->rtccntl, TYPE_ESP32C3_RTC_CNTL);
     object_initialize_child(OBJECT(machine), "jtag", &ms->jtag, TYPE_ESP32C3_JTAG);
+    object_initialize_child(OBJECT(machine), "i2c0", &ms->i2c, TYPE_ESP32_I2C);
     object_initialize_child(OBJECT(machine), "rgb", &ms->rgb, TYPE_ESP_RGB);
     object_initialize_child(OBJECT(machine), "twai", &ms->twai, TYPE_ESP32C3_TWAI);
 
@@ -448,9 +453,33 @@ static void esp32c3_machine_init(MachineState *machine)
     /* Initialize OpenCores Ethernet controller now sicne it requires the interrupt matrix */
     esp32c3_init_openeth(ms);
 
-    /* USB Serial JTAG realization */
+    /* One I2C controller with nothing on the bus, so a firmware's address scan
+     * NACKs at once instead of running every probe to timeout. Leave it empty: a
+     * device that ACKs is initialised for real, and the upstream I2C model then
+     * faults the guest on the first data phase. */
     {
+        qdev_prop_set_bit(DEVICE(&ms->i2c), "new-opcode-map", true);
+        qdev_realize(DEVICE(&ms->i2c), &ms->periph_bus, &error_fatal);
+        MemoryRegion *mr = sysbus_mmio_get_region(SYS_BUS_DEVICE(&ms->i2c), 0);
+        memory_region_add_subregion_overlap(sys_mem, DR_REG_I2C_EXT_BASE, mr, 0);
+        sysbus_connect_irq(SYS_BUS_DEVICE(&ms->i2c), 0,
+                           qdev_get_gpio_in(intmatrix_dev, ETS_I2C_EXT0_INTR_SOURCE));
+    }
+
+    /* Radio path: the GPIO out-observer the CS framing needs, then the GPSPI2
+     * controller with its SX1262 slave. Board wiring comes from -global. */
+    bramble_gpio_attach(sys_mem, NULL);
+    bramble_gpspi2_attach(sys_mem, NULL, NULL);
+
+    /* USB Serial JTAG realization. The two UARTs take serial 0 and 1, so the SoC's
+     * own USB console lands on serial 2 -- which is where a hardware-CDC build puts
+     * stdout and reads its commands from. */
+    {
+        qdev_prop_set_chr(DEVICE(&ms->jtag), "chardev", serial_hd(ESP32C3_UART_COUNT));
         sysbus_realize(SYS_BUS_DEVICE(&ms->jtag), &error_fatal);
+        sysbus_connect_irq(SYS_BUS_DEVICE(&ms->jtag), 0,
+                           qdev_get_gpio_in(intmatrix_dev,
+                                            ETS_USB_SERIAL_JTAG_INTR_SOURCE));
         MemoryRegion *mr = sysbus_mmio_get_region(SYS_BUS_DEVICE(&ms->jtag), 0);
         memory_region_add_subregion_overlap(sys_mem, DR_REG_USB_SERIAL_JTAG_BASE, mr, 0);
     }
