diff --git a/hw/i2c/esp32_i2c.c b/hw/i2c/esp32_i2c.c
index 5f4022f..f62a40c 100644
--- a/hw/i2c/esp32_i2c.c
+++ b/hw/i2c/esp32_i2c.c
@@ -4,6 +4,7 @@
 #include "qemu/error-report.h"
 #include "hw/i2c/esp32_i2c.h"
 #include "hw/irq.h"
+#include "hw/qdev-properties.h"
 
 static void esp32_i2c_do_transaction(Esp32I2CState * s);
 static void esp32_i2c_update_irq(Esp32I2CState * s);
@@ -28,6 +29,7 @@ static void esp32_i2c_reset_hold(Object *obj, ResetType type)
     s->stop_hold_reg = 0;
     s->stop_setup_reg = 0;
     memset(s->cmd_reg, 0, sizeof(s->cmd_reg));
+    s->scl_sp_conf_reg = 0;
 
     fifo8_reset(&s->tx_fifo);
     fifo8_reset(&s->rx_fifo);
@@ -45,6 +47,7 @@ static uint32_t esp32_i2c_get_status_reg(Esp32I2CState* s)
 static void esp32_i2c_update_irq(Esp32I2CState * s)
 {
     int irq_state = !!(s->int_raw_reg & s->int_ena_reg);
+    
     qemu_set_irq(s->irq, irq_state);
 }
 
@@ -72,6 +75,13 @@ static uint64_t esp32_i2c_read(void * opaque, hwaddr addr, unsigned int size)
     case A_I2C_INT_ST:
         return s->int_raw_reg & s->int_ena_reg;
     case A_I2C_CMD ... (A_I2C_CMD + ESP32_I2C_CMD_COUNT * 4):
+        /* On the newer layout this window holds 8 commands, and 0x80 is
+         * SCL_SP_CONF. SCL_RST_SLV_EN is self-clearing -- the controller drives the
+         * recovery pulses and clears it -- and the driver spins on the bit, so it
+         * must never read back set. */
+        if (s->new_register_map && addr == A_I2C_SCL_SP_CONF) {
+            return s->scl_sp_conf_reg & ~1u;
+        }
         return s->cmd_reg[(addr - A_I2C_CMD) / 4];
     case A_I2C_TIMEOUT:
         return s->timeout_reg;
@@ -138,6 +148,10 @@ static void esp32_i2c_write(void * opaque, hwaddr addr, uint64_t value, unsigned
         esp32_i2c_update_irq(s);
         break;
     case A_I2C_CMD ... (A_I2C_CMD + ESP32_I2C_CMD_COUNT * 4):
+        if (s->new_register_map && addr == A_I2C_SCL_SP_CONF) {
+            s->scl_sp_conf_reg = value;
+            break;
+        }
         s->cmd_reg[(addr - A_I2C_CMD) / 4] = value;
         break;
     case A_I2C_TIMEOUT:
@@ -178,6 +192,14 @@ static void esp32_i2c_do_transaction(Esp32I2CState * s)
     for (int i_cmd = 0; i_cmd < ESP32_I2C_CMD_COUNT && !stop_or_end; ++i_cmd) {
         uint32_t cmd = s->cmd_reg[i_cmd];
         char opcode = FIELD_EX32(cmd, I2C_CMD, OPCODE);
+        if (s->new_register_map) {
+            switch (opcode) {
+            case 6: opcode = I2C_OPCODE_RSTART; break;
+            case 3: opcode = I2C_OPCODE_READ;   break;
+            case 2: opcode = I2C_OPCODE_STOP;   break;
+            default: break;   /* WRITE and END are unchanged */
+            }
+        }
         switch (opcode) {
             case I2C_OPCODE_RSTART:
                 i2c_end_transfer(s->bus);
@@ -261,10 +283,16 @@ static void esp32_i2c_init(Object * obj)
     fifo8_create(&s->rx_fifo, ESP32_I2C_FIFO_LENGTH);
 }
 
+static Property esp32_i2c_properties[] = {
+    DEFINE_PROP_BOOL("new-register-map", Esp32I2CState, new_register_map, false),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
 static void esp32_i2c_class_init(ObjectClass * klass, void * data)
 {
     ResettableClass *rc = RESETTABLE_CLASS(klass);
     rc->phases.hold = esp32_i2c_reset_hold;
+    device_class_set_props(DEVICE_CLASS(klass), esp32_i2c_properties);
 }
 
 static const TypeInfo esp32_i2c_type_info = {
diff --git a/include/hw/i2c/esp32_i2c.h b/include/hw/i2c/esp32_i2c.h
index b17dc75..5efeea6 100644
--- a/include/hw/i2c/esp32_i2c.h
+++ b/include/hw/i2c/esp32_i2c.h
@@ -20,6 +20,12 @@ typedef struct Esp32I2CState {
 
     MemoryRegion iomem;
     qemu_irq irq;
+
+    /* The esp32s3 and esp32c3 changed the register layout: the command opcodes were
+     * renumbered (RESTART 0 -> 6, READ and STOP swapped), there are 8 command
+     * registers rather than 16, and SCL_SP_CONF occupies 0x80 -- which the original
+     * layout uses for COMD10. Selects which of the two to decode. */
+    bool new_register_map;
     I2CBus *bus;
     Fifo8 rx_fifo;
     Fifo8 tx_fifo;
@@ -38,6 +44,7 @@ typedef struct Esp32I2CState {
     uint32_t stop_hold_reg;
     uint32_t stop_setup_reg;
     uint32_t cmd_reg[ESP32_I2C_CMD_COUNT];
+    uint32_t scl_sp_conf_reg;
 } Esp32I2CState;
 
 
@@ -89,6 +96,7 @@ REG32(I2C_STOP_HOLD, 0x48);
 REG32(I2C_STOP_SETUP, 0x4c);
 
 REG32(I2C_CMD, 0x58);
+REG32(I2C_SCL_SP_CONF, 0x80);
     FIELD(I2C_CMD, BYTE_NUM, 0, 8);
     FIELD(I2C_CMD, ACK_CHECK_EN, 8, 1);
     FIELD(I2C_CMD, ACK_EXP, 9, 1);
