--- a/include/hw/misc/esp32c3_jtag.h
+++ b/include/hw/misc/esp32c3_jtag.h
@@ -12,15 +12,51 @@
 #include "hw/hw.h"
 #include "hw/sysbus.h"
 #include "hw/registerfields.h"
+#include "chardev/char-fe.h"
 
 #define TYPE_ESP32C3_JTAG "misc.esp32c3.usb_serial_jtag"
 #define ESP32C3_JTAG(obj) OBJECT_CHECK(ESP32C3UsbJtagState, (obj), TYPE_ESP32C3_JTAG)
 
 #define ESP32C3_JTAG_REGS_SIZE (0x84)
 
+/* EP1 is the byte FIFO, EP1_CONF the handshake: bit 0 WR_DONE (guest has finished a
+ * write burst), bit 1 IN_EP_DATA_FREE (host can accept more), bit 2 OUT_EP_DATA_AVAIL. */
+#define ESP32C3_JTAG_EP1            0x00
+#define ESP32C3_JTAG_EP1_CONF       0x04
+#define ESP32C3_JTAG_CONF_WR_DONE   (1 << 0)
+#define ESP32C3_JTAG_CONF_IN_FREE   (1 << 1)
+#define ESP32C3_JTAG_CONF_OUT_AVAIL (1 << 2)
+
+#define ESP32C3_JTAG_INT_RAW        0x08
+#define ESP32C3_JTAG_INT_ST         0x0c
+#define ESP32C3_JTAG_INT_ENA        0x10
+#define ESP32C3_JTAG_INT_CLR        0x14
+/* SOF is bit 1. A full-speed host emits one every 1 ms; the guest polls this bit to
+ * decide a host is attached and only then does it transmit. */
+#define ESP32C3_JTAG_INT_SOF        (1 << 1)
+/* Raised when the host has delivered a packet the guest has not read yet. */
+#define ESP32C3_JTAG_INT_OUT_RECV   (1 << 2)
+/* Raised while the IN FIFO can take more; the guest's ISR is what moves queued
+ * console output into EP1, and it disables this bit itself once the queue drains. */
+#define ESP32C3_JTAG_INT_IN_EMPTY   (1 << 3)
+
+#define ESP32C3_JTAG_EP_PACKET_SIZE 64
+#define ESP32C3_JTAG_TX_FIFO_SIZE   64
+#define ESP32C3_JTAG_RX_FIFO_SIZE   256
 
 typedef struct ESP32C3UsbJtagState {
     SysBusDevice parent_object;
     MemoryRegion iomem;
-} ESP32C3UsbJtagState;
+    CharBackend chr;
 
+    uint8_t tx[ESP32C3_JTAG_TX_FIFO_SIZE];
+    uint32_t tx_len;
+
+    uint8_t rx[ESP32C3_JTAG_RX_FIFO_SIZE];
+    uint32_t rx_head;
+    uint32_t rx_len;
+
+    qemu_irq irq;
+    uint32_t int_ena;
+    uint32_t int_raw;
+} ESP32C3UsbJtagState;
