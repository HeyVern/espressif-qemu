+
+/* The OUT endpoint delivers one packet of at most 64 bytes at a time, and the guest
+ * drains it before the next is presented -- the ROM loader reads a packet, not a byte
+ * stream, and will not touch a larger burst at all. Taking nothing while a packet is
+ * outstanding means the chardev must be restarted once it is drained; see the EP1
+ * read path. */
+static int esp32c3_jtag_can_receive(void *opaque)
+{
+    ESP32C3UsbJtagState *s = ESP32C3_JTAG(opaque);
+    return s->rx_len ? 0 : ESP32C3_JTAG_EP_PACKET_SIZE;
+}
+
+static void esp32c3_jtag_receive(void *opaque, const uint8_t *buf, int size)
+{
+    ESP32C3UsbJtagState *s = ESP32C3_JTAG(opaque);
+    for (int i = 0; i < size && s->rx_len < ESP32C3_JTAG_RX_FIFO_SIZE; i++) {
+        s->rx[(s->rx_head + s->rx_len) % ESP32C3_JTAG_RX_FIFO_SIZE] = buf[i];
+        s->rx_len++;
+    }
+    esp32c3_jtag_update_irq(s);
 }
 
