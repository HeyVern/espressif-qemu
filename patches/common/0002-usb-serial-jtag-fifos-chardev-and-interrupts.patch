+/* The guest writes console bytes into EP1 and sets WR_DONE to release the burst; it
+ * reads EP1 while OUT_EP_DATA_AVAIL is set. Both directions are bridged to a chardev,
+ * so the SoC's native USB console reaches -serial like any UART would. */
+
+static void esp32c3_jtag_update_irq(ESP32C3UsbJtagState *s)
+{
+    s->int_raw = ESP32C3_JTAG_INT_SOF | ESP32C3_JTAG_INT_IN_EMPTY |
+                 (s->rx_len ? ESP32C3_JTAG_INT_OUT_RECV : 0);
+    qemu_set_irq(s->irq, (s->int_raw & s->int_ena) ? 1 : 0);
+}
+
+static void esp32c3_jtag_flush_tx(ESP32C3UsbJtagState *s)
+{
+    if (s->tx_len == 0) {
+        return;
+    }
+    qemu_chr_fe_write_all(&s->chr, s->tx, s->tx_len);
+    s->tx_len = 0;
+}
 
 static uint64_t esp32c3_jtag_read(void *opaque, hwaddr addr, unsigned int size)
 {
     ESP32C3UsbJtagState *s = ESP32C3_JTAG(opaque);
-    (void) s;
-    return 0;
+
+    
+    switch (addr) {
+    case ESP32C3_JTAG_EP1:
+        if (s->rx_len == 0) {
+            return 0;
+        }
+        {
+            uint8_t b = s->rx[s->rx_head];
+            s->rx_head = (s->rx_head + 1) % ESP32C3_JTAG_RX_FIFO_SIZE;
+            s->rx_len--;
+            if (s->rx_len == 0) {
+                /* Packet consumed: let the chardev hand over the next one. */
+                esp32c3_jtag_update_irq(s);
+                qemu_chr_fe_accept_input(&s->chr);
+            }
+            return b;
+        }
+    case ESP32C3_JTAG_EP1_CONF:
+        /* Always accept writes; report readable data when the FIFO has any. */
+        return ESP32C3_JTAG_CONF_IN_FREE |
+               (s->rx_len ? ESP32C3_JTAG_CONF_OUT_AVAIL : 0);
+    case ESP32C3_JTAG_INT_RAW:
+        /* Stand in for a host: SOF is always freshly raised, so the guest's tick hook
+         * sees a connected bus and HWCDC transmits instead of discarding. */
+        return s->int_raw | ESP32C3_JTAG_INT_SOF | ESP32C3_JTAG_INT_IN_EMPTY;
+    case ESP32C3_JTAG_INT_ST:
+        return (s->int_raw | ESP32C3_JTAG_INT_SOF | ESP32C3_JTAG_INT_IN_EMPTY) & s->int_ena;
+    case ESP32C3_JTAG_INT_ENA:
+        return s->int_ena;
+    default:
+        return 0;
+    }
 }
 
